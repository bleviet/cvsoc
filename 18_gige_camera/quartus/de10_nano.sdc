# Timing constraints for the 18_gige_camera project.
#
# FPGA_CLK1_50 drives the fabric logic: cam_frame_writer, hdmi_preview, the LW H2F bridge
# and the FPGA-to-HPS AXI bridge. The D5M's PIXCLK drives d5m_capture and the
# write side of its async_fifo.
#
# HPS SDRAM timing constraints are generated by the Quartus fitter when the
# altera_hps component is present.

# Primary FPGA clock (50 MHz oscillator on PIN_V11)
create_clock -name {FPGA_CLK1_50} -period 20.000 [get_ports {fpga_clk1_50}]

# D5M pixel clock. M2 runs the sensor from XCLKIN = 25 MHz with its PLL off,
# so PIXCLK is 25 MHz. Tighten this before enabling the sensor PLL.
create_clock -name {D5M_PIXCLK} -period 40.000 [get_ports {d5m_pixclk}]

# Derive PLL-generated clocks (HPS internal PLLs)
derive_pll_clocks

# Add uncertainty to all clock-to-clock paths
derive_clock_uncertainty

# PIXCLK is unrelated to the fabric clock: the only crossings are
# async_fifo's Gray-coded pointers and d5m_capture's enable synchronizer.
set_clock_groups -asynchronous -group [get_clocks {D5M_PIXCLK}]

# Gray pointers: keep the bits of each bus within one destination period of
# each other, so a synchronizer never samples a half-updated pointer.
set_max_skew -from [get_keepers {*|fifo_inst|wgray[*]}] \
             -to   [get_keepers {*|fifo_inst|wgray_s1[*]}] 10.000
set_max_skew -from [get_keepers {*|fifo_inst|rgray[*]}] \
             -to   [get_keepers {*|fifo_inst|rgray_s1[*]}] 10.000

# Pixel bus. With Invert_Pixel_Clock set (camd does this), the sensor launches
# DOUT/FRAME_VALID/LINE_VALID on the falling edge of PIXCLK at the pins; the
# capture registers sample on the rising edge. MT9P001 tPD: 3 ns typical.
set_input_delay -clock {D5M_PIXCLK} -clock_fall -max 6.000 \
    [get_ports {d5m_d[*] d5m_fval d5m_lval}]
set_input_delay -clock {D5M_PIXCLK} -clock_fall -min 0.000 \
    [get_ports {d5m_d[*] d5m_fval d5m_lval}]

# Slow or static control pins, synchronized or driven from registers:
# XCLKIN (no timing relationship is used), RESETn, TRIGGER, STROBE and the
# bit-banged I2C lines.
set_false_path -to   [get_ports {d5m_xclkin d5m_reset_n d5m_trigger d5m_sclk d5m_sdata}]
set_false_path -from [get_ports {d5m_strobe d5m_sclk d5m_sdata}]

# HDMI pixel clock (74.25 MHz from video_pll). hdmi_preview only crosses
# between it and the fabric clock through synchronized toggles, quasi-static
# settings and its dual-clock line buffers.
set_clock_groups -asynchronous -group [get_clocks {*video_pll*}]

# The ADV7513 samples data, DE and syncs with HDMI_TX_CLK, which is the same
# clock leaving the FPGA; the outputs come from I/O-cell registers and the
# ADV7513's input clock delay (register 0xBA) adjusts the sampling point, as
# in Terasic's HDMI_TX demo. No timing relationship is analyzed here.
set_false_path -to [get_ports {hdmi_tx_d[*] hdmi_tx_de hdmi_tx_hs hdmi_tx_vs hdmi_tx_clk}]
set_false_path -to   [get_ports {hdmi_i2c_scl hdmi_i2c_sda}]
set_false_path -from [get_ports {hdmi_i2c_scl hdmi_i2c_sda hdmi_tx_int}]
